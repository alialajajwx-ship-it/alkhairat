<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سعر التوصيل | الخيرات</title>
<link rel="stylesheet" href="/css/common.css">
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/owner-tools.css">
</head>
<body>

<%- include('partials/header', { activePage: '' }) %>

<main class="container owner-tool-wrap">
  <div class="owner-tool-head">
    <h1>سعر التوصيل</h1>
    <p class="owner-tool-sub">حدّد رسوم التوصيل التي تظهر للعملاء في سلة الشراء وصفحة الطلب.</p>
  </div>

  <section class="panel owner-tool-card">
    <form id="delivery-form">
      <div class="tool-field">
        <label for="delivery-fee">رسوم التوصيل (ر.س)</label>
        <input type="number" id="delivery-fee" min="0" max="999" step="0.5" value="<%= deliveryFee %>" required>
        <p class="tool-hint">اكتب 0 لجعل التوصيل مجانياً لجميع الطلبات.</p>
      </div>

      <div class="tool-error" id="delivery-error"></div>

      <div class="tool-actions">
        <button type="submit" class="btn btn-primary" id="delivery-save">حفظ السعر</button>
        <a href="/dashboard" class="btn btn-outline">عودة للوحة التحكم</a>
      </div>
    </form>
  </section>
</main>

<%- include('partials/footer') %>

<script src="/js/scripts/delivery-price.js"></script>
</body>
</html>
